#!/bin/bash

if [ "$NOLINT" ]; then exit 0; fi

set -v

FLAKE8_CONFIG_DIR="$(dirname $0)/cfg"

git diff --cached --unified=0 --minimal HEAD |
flake8 --diff --config=${FLAKE8_CONFIG_DIR}/travis_run_flake8__init__.cfg
status1=$?

git diff --cached --unified=0 --minimal HEAD |
flake8 --diff --config=${FLAKE8_CONFIG_DIR}/travis_run_flake8.cfg
status2=$?

TRAVIS_PULL_REQUEST="true" TRAVIS_BRANCH="HEAD" TRAVIS_BUILD_DIR=`pwd -P` $(dirname $0)/test_pylint
pylint_status=$?
exit $((${status1} || ${status2} || ${pylint_status}))
